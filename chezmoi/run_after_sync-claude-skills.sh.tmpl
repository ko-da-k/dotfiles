#!/bin/sh
set -eu

HOME_DIR={{ .chezmoi.homeDir | quote }}
SOURCE_DIR={{ .chezmoi.sourceDir | quote }}
SKILLS_DEST="$HOME_DIR/.claude/skills"
SKILLS_SRC="$SOURCE_DIR/claude-skills"

# .claude/skills is a real directory containing one symlink per repo-tracked
# skill (edit-in-place via the repo). Machine-only skills can be added
# directly under .claude/skills/<name>/ by hand; this script never touches
# entries that don't match a name under $SKILLS_SRC.
[ -d "$SKILLS_SRC" ] || exit 0

if [ -L "$SKILLS_DEST" ]; then
  rm "$SKILLS_DEST"
fi
mkdir -p "$SKILLS_DEST"

for d in "$SKILLS_SRC"/*/; do
  [ -d "$d" ] || continue
  name="$(basename "$d")"
  link="$SKILLS_DEST/$name"
  if [ -L "$link" ] || [ -e "$link" ]; then
    rm -rf "$link"
  fi
  ln -s "$SKILLS_SRC/$name" "$link"
done
