{{- $data := dict -}}
{{- if eq .Format "toml" -}}
{{-   $data = include .BasePath | fromToml -}}
{{- else if eq .Format "yaml" -}}
{{-   $data = include .BasePath | fromYaml -}}
{{- else -}}
{{-   $data = include .BasePath | fromJsonc -}}
{{- end -}}
{{- if stat .OverridePath -}}
{{-   $override := dict -}}
{{-   if eq .Format "toml" -}}
{{-     $override = include .OverridePath | fromToml -}}
{{-   else if eq .Format "yaml" -}}
{{-     $override = include .OverridePath | fromYaml -}}
{{-   else -}}
{{-     $override = include .OverridePath | fromJsonc -}}
{{-   end -}}
{{-   $data = mergeOverwrite $data $override -}}
{{- end -}}
{{- if eq .Format "toml" -}}
{{ $data | toToml }}
{{- else if eq .Format "yaml" -}}
{{ $data | toYaml }}
{{- else -}}
{{ $data | toPrettyJson }}
{{- end -}}
